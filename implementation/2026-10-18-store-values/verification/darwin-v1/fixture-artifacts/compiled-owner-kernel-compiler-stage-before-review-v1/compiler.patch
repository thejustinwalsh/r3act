+/// Narrow executable-kernel subset: pure v2 expressions whose result is primitive.
+/// Arrays/objects and uncertain syntax remain on the existing projector path.
+fn numeric_expression_has_primitive_result(
+    source: &str,
+    state_names: &BTreeSet<String>,
+) -> bool {
+    if !numeric_expression_is_pure(source, state_names) {
         return false;
+    }
+    let chars: Vec<char> = source.chars().collect();
+    let mut index = 0;
+    let mut previous_significant = None;
+    while index < chars.len() {
+        let current = chars[index];
+        if current.is_whitespace() {
+            index += 1;
+            continue;
+        }
+        if current == '\'' || current == '"' {
+            let quote = current;
+            index += 1;
+            while index < chars.len() {
+                if chars[index] == '\\' {
+                    index += 2;
+                    continue;
+                }
+                if chars[index] == quote {
+                    index += 1;
+                    break;
+                }
+                index += 1;
+            }
+            previous_significant = Some('v');
+            continue;
+        }
+        if current == '`' {
+            index += 1;
+            while index < chars.len() {
+                if chars[index] == '\\' {
+                    index += 2;
+                    continue;
+                }
+                if chars[index] == '`' {
+                    index += 1;
+                    break;
+                }
+                if chars[index] == '$' && chars.get(index + 1) == Some(&'{') {
+                    index += 2;
+                    let expression_start = index;
+                    let mut depth = 1usize;
+                    while index < chars.len() && depth > 0 {
+                        match chars[index] {
+                            '{' => depth += 1,
+                            '}' => depth -= 1,
+                            _ => {}
+                        }
+                        if depth > 0 {
+                            index += 1;
+                        }
+                    }
+                    if depth != 0 {
+                        return false;
+                    }
+                    let nested: String = chars[expression_start..index].iter().collect();
+                    if !numeric_expression_has_primitive_result(&nested, state_names) {
+                        return false;
+                    }
+                    index += 1;
+                    continue;
+                }
+                index += 1;
+            }
+            previous_significant = Some('v');
+            continue;
+        }
+        if current.is_ascii_digit() {
+            index += 1;
+            while index < chars.len()
+                && (chars[index].is_ascii_alphanumeric()
+                    || matches!(chars[index], '.' | '_' | '+' | '-'))
+            {
+                // Keep exponent signs within numeric tokens only.
+                if matches!(chars[index], '+' | '-')
+                    && !matches!(chars[index.saturating_sub(1)], 'e' | 'E')
+                {
+                    break;
+                }
+                index += 1;
+            }
+            previous_significant = Some('v');
+            continue;
+        }
+        if current == '_' || current == '$' || current.is_ascii_alphabetic() {
+            index += 1;
+            while index < chars.len()
+                && (chars[index] == '_' || chars[index] == '$' || chars[index].is_ascii_alphanumeric())
+            {
+                index += 1;
+            }
+            let mut next = index;
+            while next < chars.len() && chars[next].is_whitespace() {
+                next += 1;
+            }
+            // Reject chained calls and tagged templates, including parenthesized callee forms
+            // handled by the closing-paren check below.
+            if matches!(chars.get(next), Some('`')) {
+                return false;
+            }
+            previous_significant = Some('v');
+            continue;
+        }
+        if matches!(current, '[' | ']' | '{' | '}') {
+            return false;
+        }
+        if current == '(' && previous_significant == Some(')') {
+            return false;
+        }
+        if !matches!(current, '(' | ')' | '+' | '-' | '*' | '/' | '%' | '?' | ':' | '!' | '<' | '>' | '&' | '|') {
+            return false;
+        }
+        previous_significant = Some(current);
+        index += 1;
     }
     true
 }
 
+fn rewrite_numeric_kernel_expression(
+    source: &str,
+    name_to_slot: &BTreeMap<String, usize>,
+) -> String {
+    let chars: Vec<char> = source.chars().collect();
+    let mut output = String::with_capacity(source.len() + 32);
+    let mut index = 0;
+    while index < chars.len() {
+        let current = chars[index];
+        if current == '\'' || current == '"' {
+            let quote = current;
+            let start = index;
+            index += 1;
+            while index < chars.len() {
+                if chars[index] == '\\' {
+                    index += 2;
+                    continue;
+                }
+                if chars[index] == quote {
+                    index += 1;
+                    break;
+                }
+                index += 1;
+            }
+            output.extend(chars[start..index].iter());
+            continue;
+        }
+        if current == '`' {
+            output.push(current);
+            index += 1;
+            while index < chars.len() {
+                if chars[index] == '\\' {
+                    output.push(chars[index]);
+                    if index + 1 < chars.len() {
+                        output.push(chars[index + 1]);
+                    }
+                    index += 2;
+                    continue;
+                }
+                if chars[index] == '`' {
+                    output.push('`');
+                    index += 1;
+                    break;
+                }
+                if chars[index] == '$' && chars.get(index + 1) == Some(&'{') {
+                    output.push('$');
+                    output.push('{');
+                    index += 2;
+                    let expression_start = index;
+                    let mut depth = 1usize;
+                    while index < chars.len() && depth > 0 {
+                        match chars[index] {
+                            '{' => depth += 1,
+                            '}' => depth -= 1,
+                            _ => {}
+                        }
+                        if depth > 0 {
+                            index += 1;
+                        }
+                    }
+                    let nested: String = chars[expression_start..index].iter().collect();
+                    output.push_str(&rewrite_numeric_kernel_expression(&nested, name_to_slot));
+                    if index < chars.len() {
+                        output.push('}');
+                        index += 1;
+                    }
+                    continue;
+                }
+                output.push(chars[index]);
+                index += 1;
+            }
+            continue;
+        }
+        if current == '_' || current == '$' || current.is_ascii_alphabetic() {
+            let start = index;
+            index += 1;
+            while index < chars.len()
+                && (chars[index] == '_' || chars[index] == '$' || chars[index].is_ascii_alphanumeric())
+            {
+                index += 1;
+            }
+            let name: String = chars[start..index].iter().collect();
+            if let Some(slot) = name_to_slot.get(&name) {
+                output.push_str(&format!("rowInputs[rowIndex * slotCount + {slot}]"));
+            } else {
+                output.push_str(&name);
+            }
+            continue;
+        }
+        output.push(current);
+        index += 1;
+    }
+    output
+}
