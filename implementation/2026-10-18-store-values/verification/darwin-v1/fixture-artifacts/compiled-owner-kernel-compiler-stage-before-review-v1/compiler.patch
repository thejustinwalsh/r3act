+fn emit_primitive_owner_cut_kernels(
+    numeric_programs: &[NativeNumericSinkCandidate],
+    state_layouts: &BTreeMap<String, Vec<NativeStateLayoutSlotMetadata>>,
+    kernel_alias: &str,
+) -> (String, BTreeMap<String, usize>) {
+    let mut owners = BTreeSet::new();
+    for program in numeric_programs {
+        owners.insert(program.owner_program_id.clone());
+    }
+    let mut kernels = Vec::new();
+    let mut indices = BTreeMap::new();
+    for owner in owners {
+        let Some(layout) = state_layouts.get(&owner) else { continue };
+        let sinks: Vec<_> = numeric_programs
+            .iter()
+            .filter(|program| program.owner_program_id == owner)
+            .collect();
+        if sinks.is_empty() || sinks.len() > 30 || layout.is_empty() || layout.len() > 30
+            || sinks.iter().any(|sink| !sink.primitive_result)
+        {
+            continue;
+        }
+        let mut names_by_site = BTreeMap::new();
+        for sink in &sinks {
+            for (site, name) in sink.source_sites.iter().zip(&sink.source_names) {
+                names_by_site.entry(site.clone()).or_insert_with(|| name.clone());
+            }
+        }
+        if layout.iter().any(|slot| !names_by_site.contains_key(&slot.site_id)) {
+            continue;
+        }
+        let name_to_slot: BTreeMap<_, _> = layout.iter().enumerate().map(|(slot, entry)| {
+            (names_by_site[&entry.site_id].clone(), slot)
+        }).collect();
+        if name_to_slot.len() != layout.len() {
+            continue;
+        }
+        let owner_id = serde_json::to_string(&owner).unwrap_or_default();
+        let sink_ids = sinks.iter().map(|sink| serde_json::to_string(&sink.sink_id).unwrap_or_default()).collect::<Vec<_>>().join(", ");
+        let mut switch_cases = String::new();
+        for (slot_index, slot) in layout.iter().enumerate() {
+            let mut case_body = String::new();
+            for (sink_index, sink) in sinks.iter().enumerate() {
+                if !sink.source_sites.iter().any(|site| site == &slot.site_id) { continue; }
+                let bit = 1u32 << sink_index;
+                let expression = rewrite_numeric_kernel_expression(&sink.expression, &name_to_slot);
+                case_body.push_str(&format!(
+                    "if ((rowState.seenMask & {bit}) === 0) {{ rowState.seenMask |= {bit}; const next = ({expression}); const sinkState = rowState.sinks[{sink_index}]; const last = sinkState.lastValue; const same = last === next ? (last !== 0 || 1 / last === 1 / next) : (last !== last && next !== next); if (!same) {{ stagedRows[stagedCount] = rowIndex; stagedSinkIds[stagedCount] = {sink_index}; stagedValues[stagedCount] = next; stagedCount++; }} }}"
+                ));
+            }
+            switch_cases.push_str(&format!("case {slot_index}: {{{case_body} break;}}"));
+        }
+        let slot_count = layout.len();
+        let code = format!(
+            "{{ schemaVersion: 1, programId: {owner_id}, slotCount: {slot_count}, sinkIds: [{sink_ids}], executeCut: function(changedRows, changedSlots, changeCount, rowInputs, rowStates, stagedRows, stagedSinkIds, stagedValues) {{ const slotCount = {slot_count}; let stagedCount = 0; for (let changeIndex = 0; changeIndex < changeCount; changeIndex++) {{ const rowIndex = changedRows[changeIndex]; const rowState = rowStates[rowIndex]; switch (changedSlots[changeIndex]) {{ {switch_cases} }} }} return stagedCount; }} }}"
+        );
+        indices.insert(owner, kernels.len());
+        kernels.push(code);
+    }
+    if kernels.is_empty() {
+        return (String::new(), indices);
+    }
+    (format!("\nconst {kernel_alias} = [{}];", kernels.join(", ")), indices)
+}
