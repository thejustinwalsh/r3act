{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "node",
      "react"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "native-jsx-types",
    "paths": {
      "native-jsx-types/jsx-runtime": [
        "./src/native_jsx_types.d.ts"
      ]
    }
  },
  "include": [
    "compiler/vite_native_module.ts",
    "compiler/vite_native_plugin.ts",
    "src/react_native_adapter.ts",
    "src/three_host.ts",
    "src/browser/native_three_host.tsx",
    "src/react_radix_dialog_adapter.ts"
  ]
}
