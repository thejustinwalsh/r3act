{
  "name": "react-runtime-research",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "deno task compiler:plan && deno task compiler:region && deno task compiler:async:plan && vite --config vite.config.ts",
    "build": "deno task compiler:plan && deno task compiler:region && deno task compiler:async:plan && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "compiler:native:smoke": "node --experimental-transform-types compiler/vite_native_module_test.mjs && node --experimental-transform-types compiler/vite_native_derived_local_test.mjs",
    "bench:kernel": "deno run src/benchmark.ts",
    "check:kernel": "deno check src/benchmark.ts",
    "bundle:size": "node scripts/measure_runtime_bundle_size.mjs",
    "check:native-tooling": "tsgo -p tsconfig.native-tooling.json",
    "package:native": "node scripts/build_native_package.mjs",
    "check:native-package": "node scripts/verify_native_package.mjs",
    "package:r3act": "node scripts/build_r3act_packages.mjs",
    "check:r3act-packages": "node scripts/verify_r3act_packages.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@radix-ui/react-dialog": "1.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "magic-string": "^1.4.3",
    "vite": "8.3.1",
    "vitexec": "^0.9.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thejustinwalsh/r3act.git"
  }
}
