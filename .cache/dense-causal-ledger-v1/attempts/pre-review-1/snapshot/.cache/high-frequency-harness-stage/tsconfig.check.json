{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "react", "vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "native-jsx-types",
    "skipLibCheck": true,
    "paths": {
      "native-jsx-types/jsx-runtime": ["../../src/native_jsx_types.d.ts"]
    }
  },
  "include": ["build_proof_plugin.ts", "vite.config.ts", "src/browser/ambient.d.ts", "src/browser/*.ts", "src/browser/*.tsx", "../../src/native_jsx_types.d.ts"]
}
