{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "native-jsx-types",
    "skipLibCheck": true,
    "paths": {
      "native-jsx-types/jsx-runtime": ["../../src/native_jsx_types.d.ts"]
    }
  },
  "include": ["src/browser/native_high_frequency_arm.tsx", "src/browser/high_frequency_contract.ts", "../../src/native_jsx_types.d.ts"]
}
