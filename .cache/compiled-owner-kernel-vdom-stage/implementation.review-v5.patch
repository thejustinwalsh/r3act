+      if ((row.seenMask & 1) !== 0) continue;
+      row.seenMask |= 1;
+      const next = evaluate(row.inputValues[0]);
+      if (!Object.is(row.sinks[0].lastValue, next)) {
+        stagedInputIndices[stagedCount] = index;
+        stagedSinkIds[stagedCount] = 0;
+        stagedValues[stagedCount] = next;
+        stagedCount++;
+      }
+    }
+    return stagedCount;
+  },
+});
