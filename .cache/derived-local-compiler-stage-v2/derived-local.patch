+                expanded = None;
+            }
+        }
+        NativePropCandidate {
+            span: candidate_span,
+            state_refs: BTreeSet::new(),
+            state_reference_sites: BTreeMap::new(),
+            derived_reference_sites,
+            expanded,
+            other_refs: false,
+        }
+    }
+}
