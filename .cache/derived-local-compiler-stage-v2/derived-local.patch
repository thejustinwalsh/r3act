+#[derive(Default)]
+struct ExpressionNodeCounter(usize);
+
+impl<'a> Visit<'a> for ExpressionNodeCounter {
+    fn visit_expression(&mut self, node: &Expression<'a>) {
+        self.0 = self.0.saturating_add(1);
+        walk::walk_expression(self, node);
+    }
